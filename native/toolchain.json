          "sha256": "8df5750ffc0281017fb6070fba450f5d22b600a02081dceef47966ffaf36a3af"
        }
      },
      "check": [
        "go",
        "version"
      ],
      "version_pattern": "(?<![0-9.])1\\.24\\.1(?![0-9.])"
    },
    "via": {
      "owner": "system",
      "version": "3.0.13",
      "policy": "explicit-reviewed-refresh",
      "method": "via",
      "destination": "/opt/via-annotator",
