{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>budgetanalyzer/orchestration//renovate-presets/default"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Discover the reviewed actionlint release",
      "managerFilePatterns": [
        "/^native\\/toolchain\\.json$/"
      ],
      "matchStrings": [
        "\"actionlint\"\\s*:\\s*\\{\\s*\"owner\"\\s*:\\s*\"system\",\\s*\"version\"\\s*:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Discover the reviewed Go release",
      "managerFilePatterns": [
        "/^native\\/toolchain\\.json$/"
      ],
      "matchStrings": [
        "\"go\"\\s*:\\s*\\{\\s*\"owner\"\\s*:\\s*\"system\",\\s*\"version\"\\s*:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Discover the reviewed mitmproxy release",
      "managerFilePatterns": [
        "/^native\\/agent-tools\\.json$/"
      ],
      "matchStrings": [
        "\"mitmproxy\"\\s*:\\s*\\{\\s*\"owner\"\\s*:\\s*\"normal-user\",\\s*\"method\"\\s*:\\s*\"pipx\",\\s*\"version\"\\s*:\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "mitmproxy",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    },
    {
      "customType": "regex",
      "description": "Discover the NodeSource major line",
      "managerFilePatterns": [
        "/^native\\/toolchain\\.json$/"
      ],
      "matchStrings": [
        "\"nodesource\"\\s*:\\s*\\{[^{}]*\"source\"\\s*:\\s*\"deb \\[signed-by=/etc/apt/keyrings/nodesource\\.gpg\\] https://deb\\.nodesource\\.com/node_(?<currentValue>\\d+)\\.x nodistro main\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    }
  ],
  "packageRules": [
    {
      "description": "Require complete checksum-coupled native binary review",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "rhysd/actionlint",
        "go"
      ],
      "dependencyDashboardApproval": true,
      "labels": [
        "dependencies",
        "checksum-required"
      ],
      "prBodyNotes": [
        "This version-only proposal is intentionally incomplete. Review and update the amd64 and arm64 release URLs and SHA-256 values, `version_pattern`, versioned `destination` where applicable, architecture support, and lifecycle compatibility before merge. Renovate does not calculate or verify these companion inputs."
      ]
    },
    {
      "description": "Keep the pinned Playwright project review-complete",
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "native/npm/package.json"
      ],
      "prBodyNotes": [
        "Playwright is the only native npm dependency; `package-lock.json` is its single version, tarball and integrity source and `package.json` must match it. Before merge, review the new release's Ubuntu 24.04 Chromium native dependency lists and update `chromium_apt` and `chromium_apt_source` in `native/toolchain.json`, plus the reviewed lock SHA-256 in `tests/native/test_install_inputs.py`. The native checks reject a lock-only upgrade until that separately reviewed provenance matches. Provider CLIs float outside this project and are not tracked."
      ]
    },
    {
      "description": "Keep NodeSource major selection review-complete",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "node"
      ],
      "prBodyNotes": [
        "Review the NodeSource repository policy text, native runtime major checks, npm compatibility, and lifecycle support together with this declared major-line change."
      ]
    }
  ]
}
