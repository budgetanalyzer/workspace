      "key_path": "/etc/apt/keyrings/nodesource.gpg",
      "source_path": "/etc/apt/sources.list.d/nodesource.list",
      "source": "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main",
      "policy": "Node major 24 / Azul Zulu JDK major 25; signed apt resolves missing packages, existing patches retained"
    },
    "azul": {
