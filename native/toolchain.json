          "sha256": "d16fac5ac83507587845c04644bdbe81896865f2cb963d570bf0f52d48e7d793"
        }
      },
      "asset_sha256": "44de1edcee45a0c442dcd028316cdce1647b4fb1a3ca3669b07cd77f39e5fc98"
    }
