  "downloads": {
    "actionlint": {
      "owner": "system",
      "version": "1.7.12",
      "policy": "explicit-reviewed-refresh",
      "method": "tar-binary",
      "destination": "/usr/local/bin/actionlint",
      "platforms": {
        "amd64": {
          "url": "https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz",
