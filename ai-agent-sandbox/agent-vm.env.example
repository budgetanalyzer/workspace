# Copy to agent-vm.env in the guest and review every value before use.
# The accepted guest storage root is /srv/budget-analyzer.
AGENT_VM_WORKTREES=/srv/budget-analyzer/worktrees
AGENT_VM_BARE=/srv/budget-analyzer/bare

# Set these from the unprivileged guest account:
# id -u; id -g; getent group docker | cut -d: -f3.
AGENT_VM_USER_UID=REPLACE_WITH_GUEST_UID
AGENT_VM_USER_GID=REPLACE_WITH_GUEST_GID
AGENT_VM_DOCKER_GID=REPLACE_WITH_GUEST_DOCKER_GID

# Set this only after ./setup.sh --guest-local creates Kind.
AGENT_VM_KUBECONFIG=REPLACE_WITH_ABSOLUTE_GUEST_KUBECONFIG

# Change deliberately when a fresh AI CLI install layer is required.
CLI_CACHE_BUST=0
